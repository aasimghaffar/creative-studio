# ------------------------------------------------------------------
# AI Creative Studio — backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

APP_NAME="AI Creative Studio"
APP_ENV=local                # local | production
APP_DEBUG=true               # detailed errors in responses (local only)
APP_URL=http://localhost:8000

# Frontend origin allowed by CORS (the React app)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Database (MySQL via XAMPP / Laragon) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_creative_studio
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- JWT ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-64-hex-chars
JWT_ISSUER=ai-creative-studio
JWT_ACCESS_TTL=900           # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000      # 30 days (seconds)

# --- Mail (PHPMailer / SMTP) ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls          # tls | ssl | none
MAIL_FROM_ADDRESS=hello@aicreativestudio.app
MAIL_FROM_NAME="AI Creative Studio"

# --- Logging ---
LOG_LEVEL=debug              # debug | info | warning | error

# --- Google AI (Gemini) ---
GOOGLE_AI_API_KEY=
GOOGLE_AI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_AI_TIMEOUT=120
