{
    "name": "aicreativestudio/backend",
    "description": "AI Creative Studio \u2014 REST API backend foundation (PHP 8.2, PDO, JWT).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8001 -t public",
        "migrate": "php database/migrate.php",
        "make-admin": "php database/make-admin.php",
        "credits-cycle": "php database/credits-cycle.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
